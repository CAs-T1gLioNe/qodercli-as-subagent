{
  "name": "qoder-as-subagent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "MCP server exposing the Qoder CN CLI (qoderclicn) as a subagent for Codex",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node scripts/probe-stdio.mjs",
    "smoke": "node scripts/smoke-qoder.mjs",
    "selfcheck": "node scripts/selfcheck.mjs",
    "e2e": "node scripts/e2e.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
